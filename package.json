{
  "name": "calorie-counting",
  "version": "1.0.0",
  "private": true,
  "description": "卡路里记录 — 拍照识别食物热量",
  "scripts": {
    "dev:h5": "uni",
    "dev:app": "uni -p app",
    "dev:app-android": "uni -p app-android",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "build:app-android": "uni build -p app-android",
    "test": "node scripts/check-templates.mjs && esbuild scripts/test-core.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/cc-test.mjs --log-level=warning && node node_modules/.cache/cc-test.mjs",
    "test:core": "esbuild scripts/test-core.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/cc-test.mjs --log-level=warning && node node_modules/.cache/cc-test.mjs",
    "check": "node scripts/check-templates.mjs && node scripts/check-native.mjs",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-app-plus": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/uni-stacktracey": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "sass": "1.77.8",
    "vite": "5.2.8"
  }
}
